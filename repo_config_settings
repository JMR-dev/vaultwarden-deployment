owner     = "JMR-dev"
name      = "vaultwarden-deployment"
mode      = "create"
action    = "apply"
state_dir = "./state"

[repo]
visibility             = "public"
description            = "Vaultwarden config"
default_branch         = "main"
topics                 = ["go", "service", "self-hosting"]
allow_merge_commit     = true
allow_squash_merge     = false
allow_rebase_merge     = true
delete_branch_on_merge = true
auto_init              = true

[ruleset]
name                   = "main"
branch                 = "main"
required_reviews       = 0
require_signed_commits = false

[[ruleset.bypass]]
actor_type = "RepositoryRole"
actor_id   = 5
mode       = "always"

[[environments]]
name                = "production"
wait_timer          = 0
prevent_self_review = false
can_admins_bypass   = true
branch_policy       = "protected"
branch_patterns     = ["main", "hotfix/*"]

[[environments]]
name = "staging"
