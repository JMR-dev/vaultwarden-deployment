[Unit]
Description=Vaultwarden
Wants=network-online.target
After=network-online.target
# No OnFailure= here: this unit runs under the rootless user's systemd, which
# can't start the system-level status-email-root@ template (and Restart=always
# rarely lets it reach "failed"). vaultwarden-container-watch.timer, a system
# unit installed by the quadlets role, mails root when a container is down.

[Container]
Image=docker.io/vaultwarden/server:latest
ContainerName=vaultwarden
AutoUpdate=registry
Network=vaultwarden.network

# /data is the GCE data disk (mounted by the Ansible base role). :Z relabels
# under SELinux private context — required for rootless container_t to
# read/write.
Volume=/data:/data:Z

# Per-stack values (DOMAIN, SIGNUPS_ALLOWED) come from the Ansible-rendered
# env file. SIGNUPS_ALLOWED is true for exactly one deploy -- the one that
# creates the operator's account on a fresh stack -- and false otherwise.
EnvironmentFile=%h/vaultwarden.env

# Static configuration. IP_HEADER=X-Forwarded-For makes the fail2ban jail
# (which reads /data/vaultwarden.log) ban real clients rather than Caddy.
# INVITATIONS_ALLOWED=false — single-user deploy. SIGNUPS_VERIFY only takes
# effect once Vaultwarden has SMTP configured (it has none here), so it is
# inert today rather than a startup error.
Environment=ROCKET_PORT=8080
Environment=ROCKET_ADDRESS=0.0.0.0
Environment=DATA_FOLDER=/data
Environment=DATABASE_URL=data/db.sqlite3
Environment=SIGNUPS_VERIFY=true
Environment=INVITATIONS_ALLOWED=false
Environment=WEB_VAULT_ENABLED=true
Environment=IP_HEADER=X-Forwarded-For
Environment=LOG_FILE=/data/vaultwarden.log
Environment=LOG_LEVEL=warn
Environment=EXTENDED_LOGGING=true
Environment=USE_SYSLOG=false
Environment=WEBSOCKET_ENABLED=true

# ADMIN_TOKEN is sourced from a Podman secret. Empty value = admin disabled
# (the plan's default). To enable /admin, add admin_token_argon2 to the
# vaultwarden-vaultwarden secret in Secret Manager; the Podman secret
# rotates on next Ansible run.
Secret=vaultwarden-admin-token,type=env,target=ADMIN_TOKEN

# Health gate for `podman auto-update`: with Notify=healthy the unit only
# counts as started once the healthcheck passes, so an image that starts but
# serves errors is rolled back instead of left running. /healthcheck.sh ships
# in the upstream image. Caddy reaches 8080 over the shared bridge network.
HealthCmd=/healthcheck.sh
HealthInterval=60s
HealthStartPeriod=30s
HealthRetries=3
Notify=healthy

[Service]
# Never start on an empty boot-disk /data: if the data disk didn't mount
# (fstab uses nofail), Vaultwarden would happily initialise a fresh vault
# there and look like total data loss.
ExecStartPre=/usr/bin/mountpoint -q /data
Restart=always
RestartSec=10s
TimeoutStartSec=300

[Install]
WantedBy=default.target
