# Managed by Ansible.
#
# Real-IP forwarding is MANDATORY for the vaultwarden jail. Caddy is the only
# thing publishing 443, so without `IP_HEADER=X-Forwarded-For` in Vaultwarden's
# env (Phase 4) the log lines carry the Caddy container IP and the jail bans
# its own reverse proxy. See Phase-4 quadlet env for the matching IP_HEADER.

[DEFAULT]
banaction       = nftables-multiport
banaction_allports = nftables-allports
# Bare `root`, not root@localhost: msmtp only alias-expands recipients with no
# '@', so root@localhost would skip /etc/aliases and be relayed (and bounce).
destemail       = root
sender          = fail2ban@{{ inventory_hostname }}
mta             = sendmail
action          = %(action_mwl)s
bantime         = 1h
findtime        = 10m
maxretry        = 5
backend         = systemd
# IAP is the only way back into the box (SSH, and the /admin tunnel), so it
# must never be banned. Access through it is already gated by IAM.
ignoreip        = 127.0.0.1/8 ::1 {{ iap_range }}

[sshd]
# Off on purpose. :22 admits only the IAP range (VPC firewall + nftables), and
# that range is in ignoreip, so this jail could never ban anything. It is also
# the only jail on backend=systemd, which silently matches nothing without
# python3-systemd -- a jail that looks armed and isn't.
enabled  = false
port     = ssh
logpath  = %(sshd_log)s

[vaultwarden]
enabled  = true
filter   = vaultwarden
port     = http,https
backend  = polling
logpath  = {{ vault_data_dir }}/vaultwarden.log
maxretry = 5
findtime = 10m
bantime  = 1h

[vaultwarden-admin]
# Stricter jail for /admin route — reachable only through an IAP tunnel
# anyway, but if Caddy's IAP-range match is misconfigured we want loud,
# fast bans before anyone notices the leak.
enabled  = true
filter   = vaultwarden-admin
port     = http,https
backend  = polling
logpath  = {{ vault_data_dir }}/vaultwarden.log
maxretry = 3
findtime = 10m
bantime  = 24h
