# Managed by Ansible.
defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file /etc/pki/tls/certs/ca-bundle.crt
logfile        /var/log/msmtp.log
# Always send as msmtp_from, envelope and header. fail2ban passes
# -f fail2ban@<host> and systemd-email writes From: systemd@<host>; most
# providers reject a sender the account hasn't verified (Gmail rewrites it).
allow_from_override off
set_from_header on

account default
host           {{ msmtp_secrets.msmtp_smtp_host }}
port           {{ msmtp_secrets.msmtp_smtp_port }}
from           {{ msmtp_secrets.msmtp_from }}
user           {{ msmtp_secrets.msmtp_smtp_user }}
password       {{ msmtp_secrets.msmtp_smtp_password }}

aliases        /etc/aliases
