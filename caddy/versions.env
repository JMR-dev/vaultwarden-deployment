# Pinned upstream versions for the custom Caddy build.
#
# Sourced by scripts/build-caddy.sh and passed to caddy/Containerfile (via
# --build-arg). Bumps are deliberate, reviewed changes — see
# ~/.claude/projects/.../memory/coraza_caddy_version.md for the
# maintenance/compat rationale.

XCADDY_VERSION=v0.4.7
CADDY_VERSION=v2.11.4

CORAZA_CADDY_MODULE=github.com/corazawaf/coraza-caddy/v2
CORAZA_CADDY_VERSION=v2.6.2

GCD_MODULE=github.com/caddy-dns/googleclouddns
GCD_VERSION=v1.1.0

# Transitive Go modules forced above what Caddy and the plugins require, for
# fixes Trivy flags that no Caddy or plugin release has picked up yet.
# Space-separated module@version; each becomes an xcaddy --replace (a go.mod
# replace, no plugin import). Drop an entry once CADDY_VERSION or a plugin
# requires that version or newer, since a replace also blocks upgrades.
#   golang.org/x/net: CVE-2026-78669 is fixed in v0.60.0; Caddy v2.11.4 wants
#   v0.55.0 and coraza-caddy v2.6.2 v0.58.0.
#   github.com/go-jose/go-jose/v4: CVE-2026-116587 is fixed in v4.1.6; Caddy
#   v2.11.4 wants v4.1.4.
GO_MODULE_PINS="golang.org/x/net@v0.61.0 github.com/go-jose/go-jose/v4@v4.1.7"

# The container bases (GO_BUILDER_IMAGE, RUNTIME_IMAGE) are ARG defaults in
# caddy/Containerfile, so its FROM lines always name a real image.

# Trivy for the scan in scripts/build-caddy.sh, pinned by digest: Trivy's own
# release tags were hijacked in 2026, so a tag alone (or the newest patch looked
# up at build time) could hand the scan to someone else's image. The digest is
# the multi-arch index of aquasec/trivy:0.76.1 (the same on ghcr.io); its trivy
# binary is byte for byte the one in the release tarballs whose checksums
# Trivy's release workflow signed for tag v0.76.1. To bump: take the new tag's
# index digest (`skopeo inspect --raw docker://docker.io/aquasec/trivy:<v> |
# sha256sum`) and check it the same way.
TRIVY_IMAGE=docker.io/aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
