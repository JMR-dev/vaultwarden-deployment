# Custom Caddy build:
#   * Caddy core pinned to what coraza-caddy/v2 targets in its go.mod
#   * coraza-caddy/v2 — WAF middleware (runs DetectionOnly in this stack)
#   * caddy-dns/googleclouddns — DNS-01 challenge provider for Cloud DNS
#
# The module and tool pins come from caddy/versions.env. scripts/build-caddy.sh
# sources that file, passes them as --build-arg, builds, and gates the result
# on a Trivy scan (used by both Gitea Actions workflows and for local builds).

# Container bases, Trixie (Debian 13) per the project convention. They're
# defaults here rather than in versions.env, so every FROM names a real image:
# with no default, BuildKit warns (InvalidDefaultArgInFrom) and a bare
# `docker build` has nothing to pull. Override with --build-arg to try
# another base.
ARG GO_BUILDER_IMAGE=docker.io/library/golang:1-trixie
ARG RUNTIME_IMAGE=gcr.io/distroless/base-debian13:nonroot

FROM ${GO_BUILDER_IMAGE} AS builder

ARG XCADDY_VERSION
ARG CADDY_VERSION
ARG CORAZA_CADDY_MODULE
ARG CORAZA_CADDY_VERSION
ARG GCD_MODULE
ARG GCD_VERSION
ARG GO_MODULE_PINS

ENV CGO_ENABLED=0
ENV GOFLAGS=-trimpath
ENV GOTOOLCHAIN=local
# The golang image's GOPATH is /go, so `go install` lands in /go/bin.
ENV PATH=/go/bin:/usr/local/go/bin:/usr/bin:/bin

RUN go install github.com/caddyserver/xcaddy/cmd/xcaddy@${XCADDY_VERSION}

# Each GO_MODULE_PINS entry (module@version) becomes --replace module=module@version.
RUN set --; for pin in ${GO_MODULE_PINS}; do set -- "$@" --replace "${pin%@*}=${pin}"; done; \
    mkdir -p /out && xcaddy build ${CADDY_VERSION} \
        --with ${CORAZA_CADDY_MODULE}@${CORAZA_CADDY_VERSION} \
        --with ${GCD_MODULE}@${GCD_VERSION} \
        "$@" \
        --output /out/caddy

# A dropped --with still builds a working Caddy -- one that fails only at
# runtime (no WAF directive, no DNS-01 provider). Fail the build instead.
RUN /out/caddy list-modules | grep -qx 'http.handlers.waf' \
 && /out/caddy list-modules | grep -qx 'dns.providers.googleclouddns'

FROM ${RUNTIME_IMAGE}

COPY --from=builder /out/caddy /usr/local/bin/caddy

LABEL org.opencontainers.image.source="https://github.com/JMR-dev/vaultwarden-deployment"
LABEL org.opencontainers.image.description="Custom Caddy with googleclouddns DNS-01 + Coraza WAF (DetectionOnly)."

EXPOSE 443
ENTRYPOINT ["/usr/local/bin/caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
